# Maintainer: paperbenni <paperbenni@gmail.com>
pkgname=instantos
pkgrel=1
pkgdesc="meta package for instantOS"
url="https://github.com/instantOS/packages"
arch=('any')
license=('GPL2')
depends=('git')

# metapackage: no sources, nothing to compile.
# Date-based version keeps the "always newest" behavior the VCS source
# previously provided (fresh version per build day).
pkgver=$(date '+%Y%m%d%H%M')

package() {

    depends+=(
        'ins'
        'instantutils'
        'instantwallpaper'
        'instantassist'
        'instantpass'
        'instantthemes'
        'instantwidgets'
        'instantcursors'
        'ttf-firacode-nerd'
        'instantconf'
        'instantwm'
        'instantlock'
        'instantmenu'
        'instantsearch'
        'instantlaunch'
        'grub-instantos'
        'islide'
        'imenu'
        'instantnotify'
        'instantsupport')

    install -dm755 "${pkgdir}/usr/share/instantos"
    printf 'instantpackages\n' >"${pkgdir}/usr/share/instantos/packages"
}
